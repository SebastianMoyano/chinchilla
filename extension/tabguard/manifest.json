{
  "manifest_version": 3,
  "name": "Chinchilla Tab Guard",
  "version": "0.6.0",
  "description": "Per-tab smarts for Chinchilla: sleeps tabs you haven't used, cold-saves ancient ones, and calms Chrome down while you game. Honest and standalone-capable.",
  "key": "",
  "permissions": ["tabs", "storage", "alarms", "nativeMessaging", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
